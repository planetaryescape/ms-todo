---
source: tests/schema_cli.rs
expression: pretty
---
{
  "input": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "description": "At most this many results",
        "type": "string",
        "x-cli": "--limit"
      },
      "list": {
        "description": "Only this list (exact name or ID) [default: every list]",
        "type": "string",
        "x-cli": "--list"
      },
      "query": {
        "description": "Words that must all appear, in any order. Also: \"an exact phrase\", prefix* for words starting with it, OR, NOT and parentheses (the operators in capitals)",
        "items": {
          "type": "string"
        },
        "type": "array",
        "x-cli": "<QUERY>"
      },
      "semantic": {
        "description": "Find tasks by meaning, not words (\"dentist\" finds \"Book teeth cleaning\"), with a local model; the query is plain text. Needs `semantic = true` under [search] in config.toml",
        "type": "boolean",
        "x-cli": "--semantic"
      },
      "status": {
        "description": "Which tasks to look through",
        "enum": [
          "open",
          "completed",
          "all"
        ],
        "x-cli": "--status"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  },
  "output": {
    "properties": {
      "context": {
        "description": "The context that narrowed the read (the active one, or --context); null when none did, as with an explicit --list",
        "properties": {
          "default_list": {
            "description": "Where a task added with no list goes, when the context names one of its lists",
            "type": "string"
          },
          "lists": {
            "description": "How many lists it covers",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "lists"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "items": {
        "items": {
          "description": "A task that matched, best match first: the task as `tasks list` gives it, with `list`, and `snippet` (by words) or `score` (--semantic)",
          "properties": {
            "attachments": {
              "description": "Its attachments' metadata, as `attachments list` gives it without `index`; absent until a sync has fetched it",
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "body": {
              "type": "object"
            },
            "categories": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "createdDateTime": {
              "type": "string"
            },
            "defer_until": {
              "description": "YYYY-MM-DD, a local day: the task is hidden from everyday views until then (ms-todo's own; the To Do apps don't hide it). On its day it shows again",
              "type": [
                "string",
                "null"
              ]
            },
            "dueDateTime": {
              "description": "Graph's dateTimeTimeZone; a date only",
              "type": "object"
            },
            "extensions": {
              "description": "ms-todo's own open extension (com.planetaryescape.mstodo), when it has one and it has been fetched. A task's may hold myDay, myDayDueSet, assignee, assigneeStatusSet and nag (minutes between nag reminders)",
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "graph_id": {
              "description": "Microsoft Graph's ID, for `raw` and debugging; commands take it too",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "ms-todo's local ID; stable, and what commands take",
              "type": "string"
            },
            "importance": {
              "enum": [
                "low",
                "normal",
                "high"
              ]
            },
            "isReminderOn": {
              "type": "boolean"
            },
            "lastModifiedDateTime": {
              "type": "string"
            },
            "list": {
              "description": "The name of the task's list",
              "type": "string"
            },
            "list_id": {
              "description": "The local ID of the task's list",
              "type": "string"
            },
            "recurrence": {
              "type": "object"
            },
            "reminderDateTime": {
              "type": "object"
            },
            "score": {
              "description": "With --semantic: how close the task is in meaning to the query, its cosine similarity (at least 0.15, at most 1), to three places",
              "type": "number"
            },
            "snippet": {
              "description": "Without --semantic: the part of the title or notes that matched, on one line: each match between ** and **, … where it was cut",
              "type": "string"
            },
            "someday": {
              "description": "Parked as Someday: hidden from everyday views until taken out (ms-todo's own)",
              "type": "boolean"
            },
            "status": {
              "description": "notStarted, waitingOnOthers or completed, among Graph's values",
              "type": "string"
            },
            "sync_state": {
              "description": "From its outbox writes: synced; pending (queued or being sent); unknown (a write may or may not have reached Microsoft To Do; never retry it, see `outbox list`); failed (a write was rejected and rolled back; see `outbox list`)",
              "enum": [
                "synced",
                "pending",
                "unknown",
                "failed"
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "graph_id",
            "sync_state",
            "list_id",
            "title",
            "defer_until",
            "someday",
            "list"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "schema_version": {
        "const": 2
      },
      "semantic": {
        "description": "With --semantic only: the embedding model, and how many tasks in the search's scope it hasn't embedded for their current text yet (missing from items, or ranked by their old text)",
        "properties": {
          "model": {
            "type": "string"
          },
          "pending": {
            "type": "integer"
          }
        },
        "required": [
          "model",
          "pending"
        ],
        "type": "object"
      },
      "sync": {
        "properties": {
          "generation": {
            "description": "Goes up by one per finished sync of the scope",
            "type": "integer"
          },
          "state": {
            "description": "initial until this scope's first sync finishes: an empty `items` then doesn't mean empty",
            "enum": [
              "initial",
              "ready"
            ]
          }
        },
        "required": [
          "state",
          "generation"
        ],
        "type": "object"
      }
    },
    "required": [
      "schema_version",
      "sync",
      "items",
      "context"
    ],
    "type": "object"
  }
}
