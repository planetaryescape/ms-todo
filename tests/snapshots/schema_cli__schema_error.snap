---
source: tests/schema_cli.rs
expression: error
---
{
  "properties": {
    "error": {
      "properties": {
        "applied": {
          "description": "Local IDs a multi-task change changed before it failed",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "candidates": {
          "description": "What an ambiguous name matched; pick one ID",
          "items": {
            "properties": {
              "created_at": {
                "description": "For a task: when Graph created it",
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "list_id": {
                "description": "For a task: its list's local ID",
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "graph_code": {
          "description": "Graph's error.code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "auth_required",
            "auth_expired",
            "auth_revoked",
            "invalid_input",
            "not_found",
            "conflict",
            "rejected",
            "rate_limited",
            "unsupported",
            "network",
            "outcome_unknown",
            "api",
            "decode",
            "daemon_unavailable",
            "internal",
            "database_too_new"
          ]
        },
        "message": {
          "type": "string"
        },
        "op_id": {
          "description": "The failed mutation's op_id",
          "type": "string"
        },
        "request_id": {
          "description": "Graph's request-id header",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  },
  "required": [
    "error"
  ],
  "type": "object"
}
