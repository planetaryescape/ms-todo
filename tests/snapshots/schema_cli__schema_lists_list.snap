{
  "input": {
    "additionalProperties": false,
    "properties": {},
    "required": [],
    "type": "object"
  },
  "output": {
    "properties": {
      "items": {
        "items": {
          "description": "A task list: every field Microsoft Graph returns, with `id` replaced",
          "properties": {
            "displayName": {
              "type": "string"
            },
            "extensions": {
              "description": "ms-todo's own open extension (com.planetaryescape.mstodo), when it has one and it has been fetched",
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "graph_id": {
              "description": "Microsoft Graph's ID, for `raw` and debugging; commands take it too",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "ms-todo's local ID; stable, and what commands take",
              "type": "string"
            },
            "isOwner": {
              "type": "boolean"
            },
            "isShared": {
              "type": "boolean"
            },
            "sync_state": {
              "description": "Always synced until offline writes arrive; never retry `unknown`",
              "enum": [
                "synced",
                "pending",
                "unknown",
                "failed"
              ]
            },
            "wellknownListName": {
              "description": "defaultList for \"Tasks\"",
              "type": "string"
            }
          },
          "required": [
            "id",
            "graph_id",
            "sync_state",
            "displayName"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "schema_version": {
        "const": 2
      },
      "sync": {
        "properties": {
          "generation": {
            "description": "Goes up by one per finished sync of the scope",
            "type": "integer"
          },
          "state": {
            "description": "initial until this scope's first sync finishes: an empty `items` then doesn't mean empty",
            "enum": [
              "initial",
              "ready"
            ]
          }
        },
        "required": [
          "state",
          "generation"
        ],
        "type": "object"
      }
    },
    "required": [
      "schema_version",
      "sync",
      "items"
    ],
    "type": "object"
  }
}
