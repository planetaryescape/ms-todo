# Shared look for every demo tape: `Source demo/common.tape` first.
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 14
Set Width 1200
Set Height 700
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 24
Set CursorBlink false

Hide
Type "export PS1='$ ' BASH_SILENCE_DEPRECATION_WARNING=1; clear"
Enter
Show
